# Single private instance. Copy to .env; never commit real credentials.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Optional exact HTTPS origin when an authenticated reverse proxy rewrites Host.
# PUBLIC_ORIGIN=https://your-private-app.example
# fixture runs without credentials. Use deepseek for real generated scenes.
GENERATOR_MODE=fixture
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Real records expire individually after 3 calendar months; the current world survives.
ARCHIVE_RETENTION_MONTHS=3
